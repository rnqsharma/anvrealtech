---
import { render } from "astro:content";
import MediaViewer from "../../components/MediaViewer.astro";
import type { MediaItem } from "../../components/MediaViewer.astro";
import Base from "../../layouts/Base.astro";
import { telLink, waLink } from "../../config/site";
import { getProperties, fmt, rupees, totalPrice } from "../../lib";

export async function getStaticPaths() {
  const properties = await getProperties();
  return properties.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const p = entry.data;
const { Content } = await render(entry);
const heading = `${p.title} in ${p.city}`;
const items: MediaItem[] = p.media.length
  ? p.media.map((m): MediaItem => m.video
      ? { type: "video", src: m.video, poster: m.poster ?? p.photo }
      : { type: "photo", image: m.photo ?? p.photo })
  : [
      { type: "photo", image: p.photo },
      ...p.gallery.map((g): MediaItem => ({ type: "photo", image: g })),
      ...(p.video ? [{ type: "video", src: p.video, poster: p.photo } as MediaItem] : []),
    ];
const msg = `Hi, I am interested in the ${p.title} in ${p.city}${p.address ? " (" + p.address + ")" : ""}, ${p.size}.`;
---
<Base title={heading} description={`${heading}. ${p.size}${p.sqft ? ` (${fmt(p.sqft)} sq ft)` : ""}${p.rate ? `, ${rupees(p.rate)} per sq yd` : ""}. Call or WhatsApp ANVRealtech for details.`}>
  <div class="wrap">
    <a class="back" href="/#list">← All properties</a>
    <div class="detail">
      <div class="main">
        <MediaViewer items={items} alt={heading} />
      </div>
      <div>
        <h1>{heading}</h1>
        {p.address && <p class="addr">{p.address}</p>}
        {p.sold && <p><strong>This property has been sold.</strong></p>}
        <div class="spec">
          <div>Size<b>{p.size}</b></div>
          {p.sqft
            ? <div>Area<b>{fmt(p.sqft)} sq ft</b></div>
            : p.rate && <div>Rate<b>{rupees(p.rate)} <small>per sq yd</small></b></div>}
        </div>
        {p.rate && totalPrice(p.size, p.rate) && (
          <div class="price">Approx. <b>{totalPrice(p.size, p.rate)}</b> for {p.size}</div>
        )}
        <div class="cta">
          <a class="btn solid" href={telLink}><svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path fill="currentColor" d="M6.6 10.8a15.1 15.1 0 0 0 6.6 6.6l2.2-2.2a1 1 0 0 1 1-.25c1.1.37 2.3.57 3.6.57a1 1 0 0 1 1 1V20a1 1 0 0 1-1 1A17 17 0 0 1 3 4a1 1 0 0 1 1-1h3.5a1 1 0 0 1 1 1c0 1.25.2 2.45.57 3.6a1 1 0 0 1-.25 1z"/></svg> Call</a>
          <a class="btn wa" href={waLink(msg)}><svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path fill="currentColor" d="M12.04 2a9.9 9.9 0 0 0-8.5 14.9L2 22l5.25-1.38A9.9 9.9 0 1 0 12.04 2zm0 18.1c-1.5 0-2.97-.4-4.25-1.17l-.3-.18-3.12.82.83-3.04-.2-.31a8.1 8.1 0 1 1 7.04 3.88zm4.45-6.06c-.24-.12-1.44-.71-1.66-.79-.22-.08-.39-.12-.55.12-.16.24-.63.79-.77.95-.14.16-.28.18-.52.06-.24-.12-1.02-.38-1.94-1.2-.72-.64-1.2-1.43-1.34-1.67-.14-.24-.02-.37.1-.49.11-.11.24-.28.36-.42.12-.14.16-.24.24-.4.08-.16.04-.3-.02-.42-.06-.12-.55-1.32-.75-1.8-.2-.47-.4-.41-.55-.42h-.47c-.16 0-.42.06-.64.3-.22.24-.84.82-.84 2s.86 2.32.98 2.48c.12.16 1.7 2.6 4.1 3.64.57.25 1.02.4 1.37.5.58.18 1.1.16 1.51.1.46-.07 1.44-.59 1.64-1.16.2-.57.2-1.06.14-1.16-.06-.1-.22-.16-.46-.28z"/></svg> WhatsApp</a>
        </div>
        <div class="desc"><Content /></div>
      </div>
    </div>
    {(p.highlights.length > 0 || p.amenities.length > 0) && (
      <section class="feat">
        {p.highlights.length > 0 && (
          <ul class="chipset" aria-label="Highlights">
            {p.highlights.map((h) => <li>{h}</li>)}
          </ul>
        )}
        {p.amenities.length > 0 && (
          <>
            <h2>Amenities</h2>
            <ul class="amen">
              {p.amenities.map((a) => (
                <li>
                  <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><circle cx="12" cy="12" r="11" fill="currentColor" opacity=".12"/><path d="M7 12.5l3.2 3.2L17 9" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/></svg>
                  <span>{a}</span>
                </li>
              ))}
            </ul>
          </>
        )}
      </section>
    )}
  </div>
</Base>
