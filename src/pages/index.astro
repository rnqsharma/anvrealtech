---
import Base from "../layouts/Base.astro";
import PropertyCard from "../components/PropertyCard.astro";
import { site } from "../config/site";
import { getProperties } from "../lib";

const properties = await getProperties();
const cities = [...new Set(properties.map((p) => p.data.city))];
---
<Base>
  <header class="hero">
    <div class="wrap">
      <div class="hwrap">
        <!-- TODO: replace the placeholder photos in src/assets/properties with real property photos. -->
        <div class="photo">
          <div class="cap">
            <p class="eyebrow">{site.hero.topLabel}</p>
            <h1>{site.hero.title}</h1>
            <p>{site.hero.text}</p>
            <div class="cbtns">
              <a class="btn solid" href="#list">View properties</a>
              <a class="btn" href="#contact">Contact us</a>
            </div>
            <p class="assure"><span aria-hidden="true">✓</span> {site.hero.sideLabel}</p>
          </div>
        </div>
      </div>
    </div>
  </header>

  <section class="sec" id="list">
    <div class="wrap">
      <h2>Available properties</h2>
      <p class="lead">Filter by location.</p>
      <div class="chips" id="chips">
        <button type="button" aria-pressed="true" data-city="All">All</button>
        {cities.map((c) => <button type="button" aria-pressed="false" data-city={c}>{c}</button>)}
      </div>
      <div class="gwrap">
        <button type="button" class="arrow prev" id="prev" aria-label="Previous property" hidden><svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><path d="M15 5l-7 7 7 7" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/></svg></button>
        <button type="button" class="arrow next" id="next" aria-label="Next property"><svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><path d="M9 5l7 7-7 7" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/></svg></button>
        <div class="g" id="grid">
          {properties.map((p) => <PropertyCard property={p} />)}
        </div>
      </div>
      <div class="empty" id="empty" hidden>No properties in this location right now. Call us to ask about upcoming listings.</div>
    </div>
  </section>
</Base>

<script>
  const chips = document.querySelectorAll<HTMLButtonElement>("#chips button");
  const cards = document.querySelectorAll<HTMLElement>("#grid .card");
  const empty = document.getElementById("empty")!;
  chips.forEach((chip) =>
    chip.addEventListener("click", () => {
      const city = chip.dataset.city!;
      chips.forEach((c) => c.setAttribute("aria-pressed", String(c === chip)));
      let shown = 0;
      cards.forEach((card) => {
        const match = city === "All" || card.dataset.city === city;
        card.hidden = !match;
        if (match) shown++;
      });
      empty.hidden = shown > 0;
      document.getElementById("grid")!.scrollTo({ left: 0 });
    })
  );
  const grid = document.getElementById("grid")!;
  const step = (dir: number) => {
    const card = grid.querySelector<HTMLElement>(".card:not([hidden])");
    const w = (card?.offsetWidth ?? grid.clientWidth) + 14;
    grid.scrollBy({ left: dir * w, behavior: "smooth" });
  };
  const prev = document.getElementById("prev") as HTMLButtonElement;
  const next = document.getElementById("next") as HTMLButtonElement;
  const sync = () => {
    prev.hidden = grid.scrollLeft < 8;
    next.hidden = grid.scrollLeft + grid.clientWidth >= grid.scrollWidth - 8;
  };
  prev.addEventListener("click", () => step(-1));
  next.addEventListener("click", () => step(1));
  grid.addEventListener("scroll", sync, { passive: true });
  chips.forEach((c) => c.addEventListener("click", () => setTimeout(sync, 50)));
  sync();
</script>
