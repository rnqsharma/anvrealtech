---
import { getImage } from "astro:assets";
import type { ImageMetadata } from "astro";

export interface MediaItem {
  type: "photo" | "video";
  image?: ImageMetadata;  // photo
  src?: string;           // video file, e.g. /videos/x.mp4
  poster?: ImageMetadata; // video preview
}
interface Props { items: MediaItem[]; alt: string; }
const { items, alt } = Astro.props;

const slides = await Promise.all(
  items.map(async (it) => {
    const img = it.image ?? it.poster;
    const [stage, thumb, full] = img
      ? await Promise.all([
          getImage({ src: img, width: 1200 }),
          getImage({ src: img, width: 240 }),
          it.type === "photo" ? getImage({ src: img, width: 1800 }) : Promise.resolve(null),
        ])
      : [null, null, null];
    return { ...it, stage: stage?.src, thumb: thumb?.src, full: full?.src };
  })
);
const many = slides.length > 1;
---
<div class="mv" data-mv>
  <div class="mv-stage">
    <div class="mv-track" tabindex="0" aria-label={`${alt} photos and videos`}>
      {slides.map((s, i) => (
        <div class="mv-slide" data-full={s.full}>
          {s.type === "photo"
            ? <img src={s.stage} alt={`${alt} photo ${i + 1}`} loading={i === 0 ? "eager" : "lazy"} />
            : <video src={s.src} poster={s.stage} controls playsinline preload="none"></video>}
        </div>
      ))}
    </div>
    {many && (
      <>
        <button type="button" class="mv-arrow mv-prev" aria-label="Previous" hidden><svg viewBox="0 0 24 24" width="26" height="26" aria-hidden="true"><path d="M15 5l-7 7 7 7" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/></svg></button>
        <button type="button" class="mv-arrow mv-next" aria-label="Next"><svg viewBox="0 0 24 24" width="26" height="26" aria-hidden="true"><path d="M9 5l7 7-7 7" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/></svg></button>
        <span class="mv-count" aria-live="polite">1 / {slides.length}</span>
      </>
    )}
  </div>
  {many && (
    <div class="mv-strip">
      {slides.map((s, i) => (
        <button type="button" class="mv-thumb" aria-label={`Show ${s.type} ${i + 1}`} aria-current={i === 0 ? "true" : "false"}>
          {s.thumb && <img src={s.thumb} alt="" loading="lazy" />}
          {s.type === "video" && <span class="mv-play" aria-hidden="true"><svg viewBox="0 0 24 24" width="14" height="14"><path d="M8 5v14l11-7z" fill="currentColor"/></svg></span>}
        </button>
      ))}
    </div>
  )}
  <dialog class="mv-lb" aria-label="Photo viewer">
    <button type="button" class="mv-lb-close" aria-label="Close">&#10005;</button>
    <button type="button" class="mv-arrow mv-lb-prev" aria-label="Previous photo">&#8249;</button>
    <img alt="" />
    <button type="button" class="mv-arrow mv-lb-next" aria-label="Next photo">&#8250;</button>
  </dialog>
</div>

<script>
  const mv = document.querySelector<HTMLElement>("[data-mv]");
  if (mv) {
    const track = mv.querySelector<HTMLElement>(".mv-track")!;
    const slides = Array.from(track.children) as HTMLElement[];
    const strip = mv.querySelector<HTMLElement>(".mv-strip");
    const thumbs = Array.from(mv.querySelectorAll<HTMLButtonElement>(".mv-thumb"));
    const prev = mv.querySelector<HTMLButtonElement>(".mv-prev");
    const next = mv.querySelector<HTMLButtonElement>(".mv-next");
    const count = mv.querySelector<HTMLElement>(".mv-count");
    const last = slides.length - 1;

    const go = (i: number) =>
      track.scrollTo({ left: Math.max(0, Math.min(last, i)) * track.clientWidth, behavior: "smooth" });

    let index = -1;
    const update = () => {
      const i = Math.round(track.scrollLeft / track.clientWidth);
      if (i === index) return;
      index = i;
      slides.forEach((s, k) => { if (k !== i) s.querySelector("video")?.pause(); });
      thumbs.forEach((t, k) => t.setAttribute("aria-current", String(k === i)));
      const t = thumbs[i];
      if (strip && t) strip.scrollTo({ left: t.offsetLeft - (strip.clientWidth - t.offsetWidth) / 2, behavior: "smooth" });
      if (prev) prev.hidden = i === 0;
      if (next) next.hidden = i === last;
      if (count) count.textContent = `${i + 1} / ${slides.length}`;
    };
    track.addEventListener("scroll", () => requestAnimationFrame(update), { passive: true });
    prev?.addEventListener("click", () => go(index - 1));
    next?.addEventListener("click", () => go(index + 1));
    thumbs.forEach((t, k) => t.addEventListener("click", () => go(k)));
    track.addEventListener("keydown", (e) => {
      if (e.key === "ArrowLeft") go(index - 1);
      if (e.key === "ArrowRight") go(index + 1);
    });
    update();

    // Tap a photo to view it large.
    const lb = mv.querySelector<HTMLDialogElement>(".mv-lb")!;
    const lbImg = lb.querySelector<HTMLImageElement>("img")!;
    const photos = slides.filter((s) => s.dataset.full);
    let lbi = 0;
    const show = (k: number) => {
      lbi = (k + photos.length) % photos.length;
      lbImg.src = photos[lbi].dataset.full!;
    };
    photos.forEach((s, k) =>
      s.querySelector("img")?.addEventListener("click", () => { show(k); lb.showModal(); })
    );
    lb.querySelector(".mv-lb-close")!.addEventListener("click", () => lb.close());
    lb.querySelector(".mv-lb-prev")!.addEventListener("click", () => show(lbi - 1));
    lb.querySelector(".mv-lb-next")!.addEventListener("click", () => show(lbi + 1));
    lb.addEventListener("click", (e) => { if (e.target === lb) lb.close(); });
    lb.addEventListener("keydown", (e) => {
      if (e.key === "ArrowLeft") show(lbi - 1);
      if (e.key === "ArrowRight") show(lbi + 1);
    });
  }
</script>
